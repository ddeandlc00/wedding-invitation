{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "stephen-raenah-wedding",
    "main": "src/worker.mjs",
    "compatibility_date": "2026-11-04",
    "limits": {
        "cpu_ms": 30000
    },
    "observability": {
        "enabled": true
    },
    // PHP answers every route. Do not set not_found_handling to
    // single-page-application: that would hide Laravel behind a static shell.
    "assets": {
        "directory": "./assets",
        "binding": "ASSETS",
        "run_worker_first": true
    },
    "vars": {
        "APP_URL": "https://stephen-raenah-wedding.workers.dev"
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "stephen-raenah-wedding",
            "database_id": "00000000-0000-0000-0000-000000000000"
        }
    ],
    "durable_objects": {
        "bindings": [
            {
                "name": "CACHE_HUB",
                "class_name": "CacheHub"
            }
        ]
    },
    "migrations": [
        {
            "tag": "cache-v1",
            "new_sqlite_classes": ["CacheHub"]
        }
    ]
}
