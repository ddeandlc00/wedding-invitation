{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "stephen-raenah-wedding",
    "main": "src/worker.mjs",
    "compatibility_date": "2026-08-01",
    "compatibility_flags": ["no_nodejs_compat", "no_nodejs_compat_v2"],
    "observability": {
        "enabled": true
    },
    // PHP answers every route. Do not set not_found_handling to
    // single-page-application: that would hide Laravel behind a static shell.
    // D1 and the cache Durable Object are added by scripts/cloudflare-prepare.mjs
    // after the database exists. A placeholder database id fails Workers Builds
    // with "unable to verify Worker" before the build command runs.
    "assets": {
        "directory": "./assets",
        "binding": "ASSETS",
        "run_worker_first": true
    },
    "vars": {
        "APP_URL": "https://stephen-raenah-wedding.josefernandodc-dev.workers.dev"
    }
}
